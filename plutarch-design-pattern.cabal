cabal-version:      3.0
name:               plutarch-design-pattern
version:            0.2.0.0

-- A short (one-line) description of the package.
-- synopsis:

-- A longer description of the package.
-- description:

-- A URL where users can report bugs.
-- bug-reports:

-- The license under which the package is released.
-- license:
author:             hadelive
maintainer:         hadelive

-- A copyright notice.
-- copyright:
-- category:
extra-source-files: README.md

common lang
  ghc-options:
    -Wall -Wcompat -Wincomplete-uni-patterns -Wno-unused-do-bind
    -Wno-partial-type-signatures -Wmissing-export-lists
    -Wincomplete-record-updates -Wmissing-deriving-strategies
    -Wno-name-shadowing -Wunused-foralls -fprint-explicit-foralls
    -fprint-explicit-kinds -Wunused-do-bind

  default-extensions:
    BangPatterns
    BinaryLiterals
    ConstrainedClassMethods
    ConstraintKinds
    DataKinds
    DeriveAnyClass
    DeriveDataTypeable
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveLift
    DeriveTraversable
    DerivingStrategies
    DerivingVia
    DoAndIfThenElse
    DuplicateRecordFields
    EmptyCase
    EmptyDataDecls
    EmptyDataDeriving
    ExistentialQuantification
    ExplicitForAll
    FlexibleContexts
    FlexibleInstances
    ForeignFunctionInterface
    GADTSyntax
    GeneralisedNewtypeDeriving
    HexFloatLiterals
    ImplicitPrelude
    ImportQualifiedPost
    InstanceSigs
    KindSignatures
    LambdaCase
    MonomorphismRestriction
    MultiParamTypeClasses
    NamedFieldPuns
    NamedWildCards
    NoFieldSelectors
    NoStarIsType
    NumericUnderscores
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    PackageImports
    PartialTypeSignatures
    PatternGuards
    PolyKinds
    PostfixOperators
    QualifiedDo
    RankNTypes
    RelaxedPolyRec
    ScopedTypeVariables
    StandaloneDeriving
    StandaloneKindSignatures
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    TypeSynonymInstances
    UndecidableInstances
    ViewPatterns

  default-language:   GHC2021

common test-dependencies
  build-depends:
    , base
    , bytestring
    , plutarch
    , plutarch-ledger-api
    , plutarch-onchain-lib
    , plutarch-testlib
    , plutus-ledger-api
    , plutus-tx
    , tasty
    , tasty-hunit
    , tasty-quickcheck
    , text

library
  import:          lang
  exposed-modules:
    Plutarch.MerkelizedValidator
    Plutarch.MultiUTxOIndexer
    Plutarch.MultiUTxOIndexerOneToMany
    Plutarch.Multivalidator
    Plutarch.SingularUTxOIndexer
    Plutarch.SingularUTxOIndexerOneToMany
    Plutarch.StakeValidator
    Plutarch.TxLevelMinter
    Plutarch.ValidityRangeNormalization

  build-depends:
    , base
    , generics-sop
    , plutarch
    , plutarch-ledger-api
    , plutarch-onchain-lib
    , plutus-ledger-api
    , plutus-tx
    , text

  hs-source-dirs:  src

test-suite plutarch-design-pattern-test
  import:         lang, test-dependencies
  type:           exitcode-stdio-1.0
  main-is:        Spec.hs
  hs-source-dirs: test
  other-modules:
    Spec.MerkelizedValidatorSpec
    Spec.MultiUTxOIndexerOneToManySpec
    Spec.MultiUTxOIndexerSpec
    Spec.SingularUTxOIndexerOneToManySpec
    Spec.SingularUTxOIndexerSpec
    Spec.StakeValidatorSpec
    Spec.TxLevelMinterSpec
    Spec.Utils

  build-depends:  plutarch-design-pattern
